# Копия для реального запуска: cp .env.example .env, затем заполнить значения ниже.
# .env в .gitignore — реальные секреты сюда не коммитятся.
#
# Требуемый layout каталогов (репозитории — соседние директории одного родителя):
#   <parent>/vulscan-kit/
#   <parent>/vulscan-core-backend/
#   <parent>/vulscan-frontend/
#   <parent>/vulscan-xss-module/
#   <parent>/vulscan-sqli-module/
#   <parent>/vulscan-idor-module/
#   <parent>/vulscan-infra/          <- этот репозиторий; docker-compose.yml лежит в infra/

# --- Core: PostgreSQL ---
CORE_DB_NAME=vulscan
CORE_DB_USER=vulscan
CORE_DB_PASSWORD=                   # openssl rand -hex 16

# --- lab-app: отдельная PostgreSQL (профиль lab) ---
LAB_DB_NAME=labapp
LAB_DB_USER=labapp
LAB_DB_PASSWORD=                    # openssl rand -hex 16

# --- Core: секреты сканера ---
SCANNER_SECRET_KEY=                 # openssl rand -base64 32  (AES-256, ровно 32 байта после декодирования)
SCANNER_TOKEN_XSS=                  # openssl rand -hex 24
SCANNER_TOKEN_SQLI=                 # openssl rand -hex 24
SCANNER_TOKEN_IDOR=                 # openssl rand -hex 24
SCANNER_BOOTSTRAP_ADMIN_USER=admin
SCANNER_BOOTSTRAP_ADMIN_PASSWORD=   # openssl rand -base64 18

# --- Сеть lab-net: одно значение используется и в compose (ipam), и как allowlist CIDR
#     в Core (SCANNER_ALLOWED_PRIVATE_CIDRS) и в модулях (WORKER_ALLOWED_PRIVATE_CIDRS) —
#     чтобы значения не расходились (см. план, N-1, риск R-5).
LAB_SUBNET=172.28.1.0/24

# --- Публикация frontend на хост (сеть edge) ---
FRONTEND_HOST_BIND=127.0.0.1
FRONTEND_HOST_PORT=8081

# --- Ресурсные лимиты контейнеров ---
CORE_MEM_LIMIT=768m
CORE_CPUS=1.5
MODULE_MEM_LIMIT=512m
MODULE_CPUS=1.0

# --- Логи (json-file, ротация) ---
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
